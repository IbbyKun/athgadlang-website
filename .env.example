# Copy to .env.local and fill in. .env* is gitignored.

# --- Supabase -------------------------------------------------------------
# Dashboard -> Project Settings -> API Keys.

# Project URL, e.g. https://abcdefghijklm.supabase.co
# Public: also used by next.config.ts to allow the storage host in next/image.
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe to expose — row level security restricts it
# to published rows only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key. SERVER ONLY — bypasses row level security.
# Never prefix this with NEXT_PUBLIC_ and never import it into a client
# component; src/lib/supabase.ts guards against that.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string for migrations only (npm run db:push). Contains the
# database password, so it is never checked in.
# Dashboard -> Project Settings -> Database -> Connection string.
# Port 5432 (session mode), NOT the 6543 transaction pooler: that one is for the
# app's queries and rejects some of what a migration needs to do.
SUPABASE_DB_URL=

# --- Admin panel ----------------------------------------------------------

# The shared password for /admin. Anyone with it can publish to the site.
ADMIN_PASSWORD=

# Signing key for the admin session cookie. Any long random string; changing
# it signs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Scheduled jobs -------------------------------------------------------

# Shared secret for /api/health/db, which Vercel Cron calls daily to stop the
# free Supabase project pausing after seven idle days. Vercel sends this value
# as `Authorization: Bearer <secret>` automatically once it is set on the
# project; the endpoint refuses every production request without it. Set it in
# the Vercel dashboard, not just here. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# --- Analytics ------------------------------------------------------------

# Google Analytics 4 measurement ID. Optional: the live property is in
# src/lib/analytics.ts, because the ID is public anyway and having it in code
# means nothing to forget when the project moves Vercel accounts. Set this only
# to point a deployment at a different property.
#
# Analytics renders only when VERCEL_ENV is "production", so local runs and
# preview deployments never report, whatever this is set to.
# NEXT_PUBLIC_GA_ID=

# --- Site -----------------------------------------------------------------

# Override the production domain, e.g. for a staging deployment.
# NEXT_PUBLIC_SITE_DOMAIN=athgadlang.com
