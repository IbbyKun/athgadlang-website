# Copy to .env.local and fill in. .env* is gitignored.

# --- Supabase -------------------------------------------------------------
# Dashboard -> Project Settings -> API.

# Project URL, e.g. https://abcdefghijklm.supabase.co
# Public: also used by next.config.ts to allow the storage host in next/image.
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe to expose — row level security restricts it
# to published rows only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key. SERVER ONLY — bypasses row level security.
# Never prefix this with NEXT_PUBLIC_ and never import it into a client
# component; src/lib/supabase.ts guards against that.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin panel ----------------------------------------------------------

# The shared password for /admin. Anyone with it can publish to the site.
ADMIN_PASSWORD=

# Signing key for the admin session cookie. Any long random string; changing
# it signs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Site -----------------------------------------------------------------

# Override the production domain, e.g. for a staging deployment.
# NEXT_PUBLIC_SITE_DOMAIN=athgadlang.com
